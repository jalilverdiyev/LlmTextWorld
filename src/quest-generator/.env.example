# Copy to .env and edit. Precedence: CLI flag > real environment variable > .env > default.
# Empty values are ignored.

# Connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=600
# How long Ollama keeps the model loaded after a request (e.g. 5m, 1h, 0, -1)
OLLAMA_KEEP_ALIVE=

# Sampling / generation options (passed to Ollama as `options`)
OLLAMA_TEMPERATURE=
OLLAMA_TOP_P=
OLLAMA_TOP_K=
OLLAMA_REPEAT_PENALTY=
OLLAMA_SEED=
OLLAMA_NUM_CTX=
# Maximum tokens to generate (Ollama's num_predict)
OLLAMA_MAX_TOKENS=
# Enable/disable thinking for models that support it (true/false)
OLLAMA_THINK=

# Metrics
METRICS_LOG=metrics.jsonl
METRICS_SAMPLE_INTERVAL=0.5

# Logging: every run writes its own file <LOG_DIR>/<timestamp>_<script>.log (DEBUG detail,
# including the prompt and the model's raw response). LOG_LEVEL only affects the console.
LOG_DIR=logs
LOG_LEVEL=INFO
